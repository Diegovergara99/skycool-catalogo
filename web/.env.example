# Copia este archivo a .env.local y completa tus valores reales antes de publicar.

# Mercado Pago — Configuración > Credenciales, en tu cuenta de Mercado Pago.
# Sin esta llave, el botón "Pagar en línea" muestra un aviso en vez de fallar.
MP_ACCESS_TOKEN=

# Número de WhatsApp de negocio en formato internacional, sin signos ni espacios
# (ejemplo: 5213312345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Redes sociales (opcional)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
